#!/bin/sh
# Remove IDE/agent attribution trailers from commit messages before the commit is created.
# Installed via: ./scripts/setup-git-hooks.sh
set -e
MSG_FILE="${1:?}"
[ -f "$MSG_FILE" ] || exit 0
TMP="${MSG_FILE}.dockercomms-strip"
grep -v -E '^(Co-authored-by: Cursor |Co-authored-by:.*cursoragent@cursor\.com|Made-with: Cursor)' "$MSG_FILE" > "$TMP" || true
mv "$TMP" "$MSG_FILE"
